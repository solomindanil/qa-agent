 const ROOT = new URL("../../", import.meta.url);
 const PLAN = { catalogProject: "freeland-staging", executionProject: "freeland-staging", mode: "full", fallback: false };
 
+// Sanitized JSON-reporter shape observed in FREEL-248 on 2026-09-15. Timing,
+// screenshots and error text are deliberately not needed by the normalizer.
+const DYNAMIC_SKIP_REPORT_TEST = {
+  projectName: "freeland-staging",
+  expectedStatus: "skipped",
+  status: "flaky",
+  annotations: [{ type: "skip", description: "The CJM storefront no longer displays prices on product cards; product-detail tests own the price contract." }],
+  results: [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }],
+};
+
+test("a dynamic skip after failure normalizes without losing either attempt or granting acceptance", () => {
+  const input = greenCampaign();
+  const safety = new Set(input.plan.safetySpine.selectedTestIds);
+  const index = input.plan.automatedTests.findIndex(row => !safety.has(row.id));
+  assert.ok(index >= 0);
+  const selected = input.plan.automatedTests[index];
+  const report = playwrightReportForTests(input.plan.automatedTests);
+  // The existing fixture emits one setup suite, then one suite per selected test.
+  let suite = report.suites[index + 1];
+  while (!suite.specs?.length) suite = suite.suites[0];
+  suite.specs[0].tests = [structuredClone(DYNAMIC_SKIP_REPORT_TEST)];
+  const originalReport = structuredClone(report);
+
+  const reconciled = reconcileAutomatedRun({
+    plan: input.plan, playwrightReport: report,
+    campaignIdentity: input.automatedRun.campaignIdentity,
+    observedAt: input.automatedRun.observedAt,
+    subprocess: { status: "completed", exitCode: 0, signal: null, reportAvailable: true },
+  });
+  const observed = reconciled.rows.find(row => row.id === selected.id);
+  assert.equal(observed.status, "skipped");
+  assert.equal(observed.expectedStatus, "skipped");
+  assert.equal(observed.sourceOutcome, "flaky");
+  assert.deepEqual(observed.attempts, [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }]);
+  assert.equal(observed.observedCount, 1);
+  assert.equal(reconciled.counts.skipped, 1);
+  assert.equal(reconciled.counts.passed, input.plan.automatedTests.length - 1);
+  assert.deepEqual(report, originalReport, "normalization must not rewrite source evidence");
+
+  Object.assign(input.automatedRun.rows.find(row => row.id === selected.id), observed);
+  input.automatedRun.counts = recomputeCounts(input.automatedRun.rows);
+  const receipt = evaluateCampaign(input).receipt;
+  assert.equal(receipt.verdict, "NEEDS_REVIEW");
+  for (const code of ["FLAKY_RESULT", "SKIPPED", "SAFETY_SPINE_INCOMPLETE"]) {
+    assert.equal(receipt.reasonCodes.includes(code), true, code);
+  }
+  assert.equal(receipt.reasonCodes.includes("UNEXPECTED_OBSERVATION"), false);
+  assert.equal(receipt.reviewIds.includes(selected.id), true);
+});
+
+test("dynamic-skip support still rejects contradictory source claims and malformed attempts", () => {
+  for (const observation of [
+    { expectedStatus: "skipped", sourceOutcome: "skipped", attempts: [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }] },
+    { expectedStatus: "passed", sourceOutcome: "unexpected", attempts: [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }] },
+    { expectedStatus: "failed", sourceOutcome: "unexpected", attempts: [{ retry: 0, status: "passed" }, { retry: 1, status: "skipped" }] },
+    { expectedStatus: "passed", sourceOutcome: "unexpected", attempts: [{ retry: 0, status: "failed" }, { retry: 1, status: "interrupted" }] },
+    { expectedStatus: "skipped", sourceOutcome: "flaky", attempts: [{ retry: 0, status: "failed" }, { retry: 0, status: "skipped" }] },
+  ]) {
+    assert.throws(() => classifyAutomatedObservation(observation), error => error.message === "AUTOMATED_OBSERVATION_INCONSISTENT");
+  }
+});
