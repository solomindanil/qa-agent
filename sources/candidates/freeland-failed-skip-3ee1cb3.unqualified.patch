+test("a failed then skipped observation keeps missing acceptance despite any skip exemption", () => {
+  for (const exemption of ["none", "mutation_gated", "known_bug", "disabled_config"]) {
+    const input = withKnownJoinIssues(greenCampaign());
+    const row = nonSafetyDesktopRow(input);
+    Object.assign(row, {
+      status: "skipped", expectedStatus: "skipped", sourceOutcome: "flaky", observedCount: 1,
+      attempts: [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }],
+    });
+    input.automatedRun.counts = recomputeCounts(input.automatedRun.rows);
+    if (exemption === "mutation_gated") input.policy.skipDispositions = [mutationGatedDisposition(row.id)];
+    if (exemption === "known_bug") input.policy.skipDispositions = [{
+      testId: row.id, class: "known_bug", ticket: "FREEL-248", expiresAt: SKIP_DISPOSITION_EXPIRY,
+      reason: "the terminal step is normally outside this campaign",
+    }];
+    if (exemption === "disabled_config") {
+      input.policy.configSkips = [{ testId: row.id, integrationKey: "lava", reason: "Lava disabled" }];
+      rebindCampaignRuntime(input, {
+        integrationModes: [{ name: "supabase", mode: "dedicated" }, { name: "lava", mode: "disabled" }],
+      });
+    }
+    const receipt = evaluateCampaign(input).receipt;
+    assert.equal(receipt.verdict, "NEEDS_REVIEW", exemption);
+    assert.deepEqual(receipt.reasonCodes, ["FLAKY_RESULT", "SAFETY_SPINE_INCOMPLETE", "SKIPPED"], exemption);
+    assert.deepEqual(receipt.reviewIds, [row.id], exemption);
+    assert.equal(receipt.coverageNotes.some(note => ["SKIP_DISPOSITION", "CONFIG_SKIP_NOT_APPLICABLE"].includes(note.code)), false, exemption);
+  }
+});
+
+test("a failed then skipped safety observation never satisfies the clean safety spine", () => {
+  const input = withKnownJoinIssues(greenCampaign());
+  const row = input.automatedRun.rows.find(candidate => candidate.id === input.plan.safetySpine.selectedTestIds[0]);
+  Object.assign(row, {
+    status: "skipped", expectedStatus: "skipped", sourceOutcome: "flaky", observedCount: 1,
+    attempts: [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }],
+  });
+  input.automatedRun.counts = recomputeCounts(input.automatedRun.rows);
+  input.automatedRun.automatedStatus = "incomplete";
+  const receipt = evaluateCampaign(input).receipt;
+  assert.equal(receipt.verdict, "NEEDS_REVIEW");
+  assert.deepEqual(receipt.reasonCodes, ["FLAKY_RESULT", "SAFETY_SPINE_INCOMPLETE", "SKIPPED"]);
+  assert.equal(receipt.reviewIds.includes(row.id), true);
+});
+
+test("a flaky mobile skip retains SKIPPED instead of gaining a policy exemption", () => {
+  const input = withKnownJoinIssues(greenCampaign());
+  const row = input.automatedRun.rows.find(candidate => candidate.project === "freeland-pixel-5" && candidate.expectedStatus === "passed");
+  Object.assign(row, {
+    status: "skipped", sourceExpectedStatus: "skipped", sourceOutcome: "flaky", observedCount: 1,
+    attempts: [{ retry: 0, status: "failed" }, { retry: 1, status: "skipped" }],
+  });
+  input.automatedRun.counts = recomputeCounts(input.automatedRun.rows);
+  input.policy.skipDispositions = [mutationGatedDisposition(row.id)];
+  const receipt = evaluateCampaign(input).receipt;
+  assert.equal(receipt.verdict, "NEEDS_REVIEW");
+  assert.equal(receipt.reasonCodes.includes("FLAKY_RESULT"), true);
+  assert.equal(receipt.reasonCodes.includes("SKIPPED"), true);
+  assert.equal(receipt.coverageNotes.some(note => note.code === "SKIP_DISPOSITION"), false);
+});
